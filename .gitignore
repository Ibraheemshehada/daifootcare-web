# Published model bundle (~208 MB) — deployed to the server, never committed
/storage/app/models/*
!/storage/app/models/.gitkeep

# Clinical photographs used as parity fixtures. Real wound images of real
# people: kept locally and shared deliberately, not carried in git history
# where they cannot be removed.
/inference/testdata/*
!/inference/testdata/.gitkeep

# Any .env backup. One of these was committed with a live APP_KEY during the
# MySQL conversion — the pattern, not just the one filename, is what needs
# ignoring.
.env.*.bak
.env.bak

# Local pre-edit backups
/_backups/

# Local python venv and bytecode for the inference service
inference/.venv/
inference/__pycache__/
**/__pycache__/
